---
export const prerender = false;
import AdminLayout from '../../layouts/AdminLayout.astro';
import { requireAdmin } from '../../lib/auth';
import { supabaseAdmin } from '../../lib/supabase';

const admin = await requireAdmin(Astro.cookies);
if (!admin) return Astro.redirect('/admin/login/');

const { data } = await supabaseAdmin
  .from('contact_messages')
  .select('*')
  .order('created_at', { ascending: false })
  .limit(200);
const list = data ?? [];
const fmt = (s: string) => new Date(s).toLocaleString('pt-BR');
---
<AdminLayout
  title="Contatos · Admin"
  active="contatos"
  pageTitle="Mensagens de Contato"
  pageSubtitle={`${list.length} mensagens recebidas`}
>
  {list.length === 0 && <div class="panel empty">Nenhuma mensagem recebida ainda.</div>}
  {list.map(c => (
    <div class={`ct-card ${c.read ? 'is-read' : ''}`} data-id={c.id}>
      <div class="ct-head">
        <div>
          <div class="ct-author">{c.name} {!c.read && <span class="badge">NOVO</span>}</div>
          <a href={`mailto:${c.email}`} class="ct-email">{c.email}</a>
        </div>
        <div class="ct-date">{fmt(c.created_at)}</div>
      </div>
      <div class="ct-subject"><strong>Assunto:</strong> {c.subject}</div>
      <div class="ct-body">{c.message}</div>
      <div class="ct-actions">
        {!c.read && <button class="btn btn-mark" data-action="mark-read">Marcar como lida</button>}
        <a href={`mailto:${c.email}?subject=Re:%20${encodeURIComponent(c.subject)}`} class="btn btn-reply">Responder por e-mail</a>
        <button class="btn btn-delete" data-action="delete">Excluir</button>
      </div>
    </div>
  ))}

  <style>
    .ct-card { background: #16161a; border: 1px solid #232328; border-radius: 10px; padding: 18px 20px; margin-bottom: 12px; border-left: 4px solid #a855f7; }
    .ct-card.is-read { opacity: .65; border-left-color: #232328; }
    .ct-head { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 14px; gap: 12px; flex-wrap: wrap; }
    .ct-author { font-weight: 700; color: #fff; font-size: 1rem; display: flex; align-items: center; gap: 8px; }
    .badge { background: #a855f7; color: #fff; font-size: .65rem; padding: 2px 8px; border-radius: 4px; font-weight: 800; letter-spacing: .5px; }
    .ct-email { color: #8a8a8f; text-decoration: none; font-size: .85rem; }
    .ct-email:hover { color: #fff; }
    .ct-date { color: #6e6e74; font-size: .8rem; }
    .ct-subject { color: #d6d6dc; font-size: .9rem; margin-bottom: 10px; }
    .ct-body { color: #d6d6dc; line-height: 1.55; white-space: pre-wrap; margin-bottom: 14px; font-size: .95rem; background: #0f0f12; padding: 14px; border-radius: 6px; }
    .ct-actions { display: flex; gap: 8px; flex-wrap: wrap; }
    .btn { padding: 8px 16px; border: none; border-radius: 6px; font-weight: 700; cursor: pointer; font-size: .8rem; text-decoration: none; display: inline-block; }
    .btn-mark { background: #a855f7; color: #fff; }
    .btn-reply { background: #3b82f6; color: #fff; }
    .btn-delete { background: #dc2626; color: #fff; }
    .btn:disabled { opacity: .5; cursor: wait; }
  </style>

  <script is:inline>
    document.querySelectorAll('button[data-action]').forEach(btn => {
      btn.addEventListener('click', async () => {
        const card = btn.closest('.ct-card');
        const id = Number(card.dataset.id);
        const action = btn.dataset.action;
        if (action === 'delete' && !confirm('Excluir esta mensagem?')) return;
        card.querySelectorAll('button').forEach(b => b.disabled = true);
        try {
          const res = await fetch('/api/admin/contact-action/', {
            method: 'POST',
            headers: { 'content-type': 'application/json' },
            body: JSON.stringify({ id, action })
          });
          const data = await res.json();
          if (!data.ok) throw new Error(data.error || 'Erro');
          if (action === 'delete') {
            card.style.transition = 'opacity .3s';
            card.style.opacity = '0';
            setTimeout(() => card.remove(), 300);
          } else if (action === 'mark-read') {
            card.classList.add('is-read');
            btn.remove();
            const badge = card.querySelector('.badge');
            if (badge) badge.remove();
          }
        } catch (e) {
          alert('Erro: ' + e.message);
          card.querySelectorAll('button').forEach(b => b.disabled = false);
        }
      });
    });
  </script>
</AdminLayout>
