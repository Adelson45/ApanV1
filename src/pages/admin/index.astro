---
export const prerender = false;
import AdminLayout from '../../layouts/AdminLayout.astro';
import { requireAdmin } from '../../lib/auth';
import { supabaseAdmin } from '../../lib/supabase';

const admin = await requireAdmin(Astro.cookies);
if (!admin) return Astro.redirect('/admin/login/');

const [subs, pending, approved, contacts] = await Promise.all([
  supabaseAdmin.from('newsletter_subscribers').select('id', { count: 'exact', head: true }),
  supabaseAdmin.from('comments').select('id', { count: 'exact', head: true }).eq('status', 'pending'),
  supabaseAdmin.from('comments').select('id', { count: 'exact', head: true }).eq('status', 'approved'),
  supabaseAdmin.from('contact_messages').select('id', { count: 'exact', head: true })
]);

const stats = [
  { num: subs.count ?? 0,     label: 'Inscritos Newsletter',  color: '#3b82f6', bg: 'rgba(59,130,246,.15)',  svg: '<path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/>' },
  { num: pending.count ?? 0,  label: 'Comentários Pendentes', color: '#eab308', bg: 'rgba(234,179,8,.15)',  svg: '<circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>' },
  { num: approved.count ?? 0, label: 'Comentários Aprovados', color: '#22c55e', bg: 'rgba(34,197,94,.15)',  svg: '<path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>' },
  { num: contacts.count ?? 0, label: 'Contatos',              color: '#a855f7', bg: 'rgba(168,85,247,.15)', svg: '<path d="M3 11l18-8-8 18-2-8z"/>' }
];
---
<AdminLayout
  title="Dashboard · Jovem Apan Admin"
  active="dashboard"
  pageTitle="Dashboard"
  pageSubtitle="Visão geral do Jovem Apan"
  pageIcon='<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="23 6 13.5 15.5 8.5 10.5 1 18"/><polyline points="17 6 23 6 23 12"/></svg>'
>
  <div class="stats-grid">
    {stats.map(s => (
      <div class="stat-card">
        <div class="stat-icon" style={`background:${s.bg};color:${s.color}`}>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={s.svg}></svg>
        </div>
        <div class="stat-num">{s.num}</div>
        <div class="stat-label">{s.label}</div>
      </div>
    ))}
  </div>

  <style>
    .stats-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 16px;
    }
    .stat-card {
      background: #16161a;
      border: 1px solid #232328;
      border-radius: 10px;
      padding: 20px;
    }
    .stat-icon {
      width: 42px; height: 42px;
      border-radius: 8px;
      display: flex; align-items: center; justify-content: center;
      margin-bottom: 16px;
    }
    .stat-icon svg { width: 22px; height: 22px; }
    .stat-num { font-size: 2rem; font-weight: 900; line-height: 1; margin-bottom: 6px; }
    .stat-label { color: #8a8a8f; font-size: .85rem; font-weight: 600; }
    @media (max-width: 1100px) { .stats-grid { grid-template-columns: repeat(2, 1fr); } }
    @media (max-width: 560px) { .stats-grid { grid-template-columns: 1fr; } }
  </style>
</AdminLayout>
