    badgeStyle: 'desconto' as const,
    image: '/images/capacete-hjc-i100-180-beston-verde-preto-56.webp',
    imageAlt: 'Capacete HJC I100',
    name: 'Capacete HJC I100',
    mercadoLivreHref: 'https://meli.la/2BXuBMs',
    amazonHref: 'https://amzn.to/42eZ9kD'
  },
  {
    badge: 'Aproveite 15% de DESCONTO',
    badgeStyle: 'desconto' as const,
    image: '/images/capacete-hjc-rpha-11-carbon-bleer-preto-e-cinza-56.webp',
    imageAlt: 'Capacete HJC RPHA 11',
