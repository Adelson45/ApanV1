    badgeStyle: 'desconto' as const,
    image: '/images/jaqueta-texx-sniper-v2-masculina.webp',
    imageAlt: 'Jaqueta Texx Sniper V2',
    name: 'Jaqueta Texx Sniper V2',
    mercadoLivreHref: 'https://meli.la/17XE3Kc',
    amazonHref: 'https://amzn.to/49pCypj'
  },
  {
    badge: 'Aproveite 30% de DESCONTO',
    badgeStyle: 'desconto' as const,
