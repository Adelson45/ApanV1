---
import PostLayout from '../layouts/PostLayout.astro';
import { fichas } from '../data/fichasTecnicas';

const title = 'HJC i90 Hollen: Certificação, Recursos, Prós e Contras';
const description = 'Veja certificação, casco, viseira solar, interior e compatibilidade com intercomunicador do HJC i90, com dados oficiais da fabricante, além de prós e contras.';
